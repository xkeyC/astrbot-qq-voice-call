{
  "manifest_version": 2,
  "id": "github.claudiagardner.maibot-qq-voice-call",
  "version": "0.3.3",
  "name": "MaiBot QQ Voice Call",
  "description": "Low-latency QQ voice calls through an external NapCat AV bridge.",
  "author": {
    "name": "ClaudiaGardner",
    "url": "https://github.com/ClaudiaGardner"
  },
  "license": "GPL-3.0-only",
  "urls": {
    "repository": "https://github.com/ClaudiaGardner/maibot-qq-voice-call",
    "documentation": "https://github.com/ClaudiaGardner/maibot-qq-voice-call/tree/main/docs",
    "issues": "https://github.com/ClaudiaGardner/maibot-qq-voice-call/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.4",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.10.0,<4.0.0"
    }
  ],
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "phone-call",
      "background": "#7c3aed"
    }
  },
  "capabilities": [
    "llm.generate",
    "llm.transcribe_audio",
    "config.get",
    "chat.open_session",
    "maisaka.context.append",
    "message.get_recent",
    "message.build_readable",
    "person.get_id",
    "person.get_value"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  }
}
